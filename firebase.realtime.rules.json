{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('users').child(auth.uid).child('role').val() === 'chapter_admin' && root.child('users').child($uid).child('chapterCode').val() === root.child('users').child(auth.uid).child('chapterCode').val()))",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "name": {
          ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('users').child(auth.uid).child('role').val() === 'chapter_admin' && root.child('users').child($uid).child('chapterCode').val() === root.child('users').child(auth.uid).child('chapterCode').val()))",
          ".validate": "newData.isString()"
        },
        "email": {
          ".validate": "newData.isString() || !newData.exists()"
        },
        "role": {
          ".validate": "newData.val() === 'user' || newData.val() === 'contributor' || newData.val() === 'admin' || newData.val() === 'chapter_admin'"
        },
        "chapterCode": {
          ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('users').child(auth.uid).child('role').val() === 'chapter_admin' && root.child('users').child($uid).child('chapterCode').val() === root.child('users').child(auth.uid).child('chapterCode').val()))",
          ".validate": "newData.isString() || !newData.exists()"
        },
        "createdAt": {
          ".validate": "newData.isString() || !newData.exists()"
        },
        "lastLogin": {
          ".validate": "newData.isString() || !newData.exists()"
        },
        "grade": {
          ".validate": "newData.isString() || !newData.exists()"
        },
        "referralSource": {
          ".validate": "newData.isString() || !newData.exists()"
        },
        "hosaEvents": {
          ".validate": "newData.hasChildren() || !newData.exists()",
          "$index": {
            ".validate": "$index.matches(/^[0-9]+$/) && newData.isString()"
          }
        },
        "hosaEventsOther": {
          ".validate": "newData.isString() || !newData.exists()"
        },
        "experienceLevel": {
          ".validate": "newData.isString() || !newData.exists()"
        },
        "goal": {
          ".validate": "newData.isString() || !newData.exists()"
        },
        "charterOrganization": {
          ".validate": "newData.isString() || !newData.exists()"
        },
        "questionsPerSession": {
          ".validate": "newData.isString() || !newData.exists()"
        },
        "onboardingCompleted": {
          ".validate": "newData.isBoolean() || !newData.exists()"
        },
        "settings": {
          "accuracyGoal": {
            ".validate": "newData.isNumber() && newData.val() >= 50 && newData.val() <= 100"
          },
          "sessionQuestionLimit": {
            ".validate": "newData.isNumber() && (newData.val() == 10 || newData.val() == 25 || newData.val() == 50 || newData.val() == 100)"
          },
          "showExplanationTime": {
            ".validate": "newData.isBoolean() || !newData.exists() || newData.hasChild('joinedAt')",
            "joinedAt": { ".validate": "newData.isString() || !newData.exists()" }
          },
          "$otherSetting": {
            ".validate": false
          }
        },
        "question_submissions": {
          "$submissionId": {
            ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (auth.uid === $uid && root.child('users').child(auth.uid).child('role').val() === 'contributor'))",
            ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (auth.uid === $uid && root.child('users').child(auth.uid).child('role').val() === 'contributor'))"
          }
        },
        "events": {
          "$eventId": {
            "wrongQuestions": {
              "$index": {
                ".validate": "$index.matches(/^[0-9]+$/) && newData.isNumber() && newData.val() >= 0"
              }
            },
            "completedQuestions": {
              "$index": {
                ".validate": "$index.matches(/^[0-9]+$/) && newData.isNumber() && newData.val() >= 0"
              }
            },

            "questionProgress": {
              "$questionId": {
                "questionId": { ".validate": "newData.isString()" },
                "repetitionCount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "correctCount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "incorrectCount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "streakCorrect": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "easeFactor": { ".validate": "newData.isNumber() && newData.val() >= 1.3 && newData.val() <= 2.8" },
                "intervalDays": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "nextDueDate": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
                "nextDueTime": { ".validate": "newData.isString() || !newData.exists()" },
                "lastSeenDate": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
                "lastResponseTime": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "qualityScore": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
                "lastQualityScore": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" },
                "averageResponseTime": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "recentQualityScores": {
                  "$idx": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" }
                },
                "recentCorrectness": {
                  "$idx": { ".validate": "newData.isBoolean() || !newData.exists() || newData.hasChild('joinedAt')",
            "joinedAt": { ".validate": "newData.isString() || !newData.exists()" } }
                }
              }
            },
            "sessions": {
              "$sessionId": {
                "sessionId": { ".validate": "newData.isString() && newData.val().length > 0" },
                "sessionType": { ".validate": "newData.isString() && (newData.val() == 'practice' || newData.val() == 'timed')" },
                "event": { ".validate": "newData.isString() && newData.val().length > 0" },
                "startTimestamp": { ".validate": "newData.isString() && newData.val().length > 0" },
                "endTimestamp": { ".validate": "newData.isString() || !newData.exists()" },
                "totalThinkTime": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "totalExplanationTime": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "totalQuestions": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "correctCount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "accuracy": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
                "attempts": { ".validate": "newData.isString()" },
                "startTime": { ".validate": "newData.isString() || !newData.exists()" },
                "endTime": { ".validate": "newData.isString() || !newData.exists()" },
                "eventId": { ".validate": "newData.isString() || !newData.exists()" },
                "$otherSessionDetail": {
                  ".validate": "newData.isNumber() || newData.isString() || newData.isBoolean() || !newData.exists()"
                }
              }
            },
            "stats": {
              "questionsAnswered": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "accuracy": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
              },
              "$otherEventStat": {
                ".validate": "newData.isNumber() || newData.isString() || newData.isBoolean()"
              }
            }
          }
        },
        "generalStats": {
          "questionsAnswered": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "accuracy": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "bestEvent": {
            ".validate": "newData.isString() && newData.val().length > 0"
          },
          "$otherGeneralStat": {
            ".validate": "newData.isNumber() || newData.isString() || newData.isBoolean()"
          }
        },
        "currentSession": {
          ".validate": "newData.val() == null || newData.hasChildren(['sessionId', 'sessionType', 'event', 'startTimestamp', 'attempts'])"
        }
      }
    },
    "chapters": {
      ".read": "auth != null",
      "$chapterCode": {
        ".read": "auth != null && (data.child('adminUid').val() === auth.uid || data.child('members').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || ( !data.exists() && newData.child('adminUid').val() === auth.uid && root.child('users').child(auth.uid).child('role').val() === 'chapter_admin') || data.child('adminUid').val() === auth.uid )",
        "chapterName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "schoolName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "charterOrganization": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "affiliation": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
        "chapterType": { ".validate": "newData.val() === 'High School' || newData.val() === 'College' || newData.val() === 'Independent'" },
        "adminUid": { ".validate": "newData.isString() && newData.val().length > 0" },
        "adminRole": { ".validate": "newData.val() === 'President' || newData.val() === 'Officer' || newData.val() === 'Advisor' || newData.val() === 'Other'" },
        "createdAt": { ".validate": "newData.isString()" },
        "members": {
          "$uid": {
            ".validate": "newData.isBoolean() || !newData.exists() || newData.hasChild('joinedAt')",
            "joinedAt": { ".validate": "newData.isString() || !newData.exists()" }
          }
        },
        "tests": {
          "$testId": {
            ".read": "auth != null && (root.child('chapters').child($chapterCode).child('adminUid').val() === auth.uid || root.child('chapters').child($chapterCode).child('members').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'admin')",
            ".write": "auth != null && (root.child('chapters').child($chapterCode).child('adminUid').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
            "eventName": { ".validate": "newData.isString()" },
            "deadlineAt": { ".validate": "newData.isString()" },
            "status": { ".validate": "newData.val() === 'active' || newData.val() === 'completed' || !newData.exists()" },
            "assignedMembers": {
              "$uid": { ".validate": "newData.isBoolean() || !newData.exists()" }
            },
            "results": {
              "$uid": {
                ".validate": "newData.hasChildren() || !newData.exists()"
              }
            }
          }
        }
      }
    },
    "event_requests": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$requestId": {
        ".write": "auth != null"
      }
    },
    "question_submissions": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$submissionId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || data.child('submittedBy').child('uid').val() === auth.uid)",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'contributor')"
      }
    },
    "question_reports": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$reportId": {
        ".write": "auth != null"
      }
    },
    "feedback_submissions": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$feedbackId": {
        ".write": "auth != null"
      }
    },

    "leaderboard": {
      "users": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          "uid": { ".validate": "newData.isString() && newData.val() === $uid" },
          "displayName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
          "initials": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 3" },
          "updatedAt": { ".validate": "newData.isString()" },
          "overall": {
            "questionsAnswered": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "correctAnswers": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "accuracy": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
            "longestStreak": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "$otherOverallStat": { ".validate": false }
          },
          "events": {
            "$eventId": {
              "questionsAnswered": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "correctAnswers": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "accuracy": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
              "longestStreak": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "$otherEventStat": { ".validate": false }
            }
          },
          "$otherLeaderboardField": { ".validate": false }
        }
      }
    },
    "admin_stats": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$node": {
        ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean() || newData.hasChildren() || newData.val() == null"
      }
    }
  }
}
